# Local development variables. When developed locally with Saleor inside docker, these can be set to:
#
# APP_IFRAME_BASE_URL=http://localhost:3000 — so Dashboard on host can access iframe
# APP_API_BASE_URL=http://host.docker.internal:3000 — so Saleor can reach App on host
#
# If developed with tunnels, leave empty; it falls back to the address the app is reached from.

# Shippo API token (use shippo_test_… for test mode)
# https://portal.goshippo.com/
SHIPPO_API_KEY=

# Origin / warehouse address (required for rate requests)
FROM_NAME=
FROM_STREET1=
FROM_STREET2=
FROM_CITY=
FROM_STATE=
FROM_ZIP=
FROM_COUNTRY=
FROM_PHONE=
FROM_EMAIL=

# Optional: comma-separated Shippo carrier account object IDs.
# Leave empty to receive rates from all carriers connected to the Shippo account.
# CARRIER_ACCOUNT_IDS=f1f8b350f37c4147a592ac6877743ae4

# Pino level: fatal | error | warn | info | debug | trace (case-insensitive)
LOG_LEVEL=info
